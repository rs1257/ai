    {
      "id": "sd0006j42gEnI5sEt6",
      "type": "text",
      "x": 590,
      "y": -191.97730840870173,
      "width": 700.235595703125,
      "height": 180,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
