    },
    {
      "id": "sd1907NsGCWHXvw1VK",
      "type": "text",
      "x": 3502.5,
      "y": 1595,
      "width": 580,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
