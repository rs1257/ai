    },
    {
      "id": "sd1871yBvEjK4jDVDa",
      "type": "text",
      "x": 3502.5,
      "y": 420,
      "width": 649.5999999999999,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 280209742,
      "version": 40,
      "versionNonce": 605593718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "The government changes the bands tomorrow. What happens?",
      "originalText": "The government changes the bands tomorrow. What happens?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8I"
    },
    {
      "id": "sd1872xODvi7xI0vFg",
      "type": "text",
      "x": 3502.5,
      "y": 451,
      "width": 2013.7599999999998,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1062031246,
      "version": 40,
      "versionNonce": 1897798633,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Tax rules live in versioned, effective-dated config (AppConfig), not in code or the prompt. Calculation uses the completion date to pick the rule set, and new rules are published before their effective date.\nCalculator rules and the RAG corpus are updated together behind an SME approval and regression tests; the eval set checks calculator output against worked examples in the current guidance, so drift between the two is\ncaught. Old versions are kept for audit.",
      "originalText": "Look for: Tax rules live in versioned, effective-dated config (AppConfig), not in code or the prompt. Calculation uses the completion date to pick the rule set, and new rules are published before their effective date.\nCalculator rules and the RAG corpus are updated together behind an SME approval and regression tests; the eval set checks calculator output against worked examples in the current guidance, so drift between the two is\ncaught. Old versions are kept for audit.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8J"
    },
