      "index": "b8z"
    },
    {
      "id": "sd1915og6d73j8Cwlx",
      "type": "text",
      "x": 3502.5,
      "y": 1845,
      "width": 1078.8,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1574279054,
      "version": 40,
      "versionNonce": 836728194,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "How do you make clear this isn't tax advice, and when should it hand off to HMRC or a person?",
      "originalText": "How do you make clear this isn't tax advice, and when should it hand off to HMRC or a person?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b90"
    },
    {
      "id": "sd19165jy50RohED3j",
      "type": "text",
      "x": 3502.5,
      "y": 1876,
      "width": 1920.9599999999998,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1721202126,
      "version": 40,
      "versionNonce": 951467572,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Clear 'guidance, not advice' wording in the UI and answers, with links to HMRC's own calculator and helpline. Hands off when retrieval confidence is low, the case is complex (e.g. mixed-use, linked\ntransactions, reliefs it can't confirm) or the user asks. Accessible UI (WCAG 2.2 AA). Never presents a figure as a binding tax liability.",
      "originalText": "Look for: Clear 'guidance, not advice' wording in the UI and answers, with links to HMRC's own calculator and helpline. Hands off when retrieval confidence is low, the case is complex (e.g. mixed-use, linked\ntransactions, reliefs it can't confirm) or the user asks. Accessible UI (WCAG 2.2 AA). Never presents a figure as a binding tax liability.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b91"
    },
