    {
      "id": "sd1920APerbIcQWeID",
      "type": "text",
      "x": 3502.5,
      "y": 1991,
      "width": 2013.7599999999998,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1436442766,
      "version": 40,
      "versionNonce": 647561393,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Shortlists on quality against the golden set, tool-calling reliability, latency and cost per answer, plus data handling and regional availability. Pins model versions. Upgrades go through the eval gate, then\na canary with rollback, comparing groundedness, tool-call success and cost before full rollout.",
      "originalText": "Look for: Shortlists on quality against the golden set, tool-calling reliability, latency and cost per answer, plus data handling and regional availability. Pins model versions. Upgrades go through the eval gate, then\na canary with rollback, comparing groundedness, tool-call success and cost before full rollout.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
