      "text": "Q1",
      "originalText": "Q1",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sd1861xYuzoy7pxJxI",
      "autoResize": true,
