      "seed": 377119118,
      "version": 40,
      "versionNonce": 849739653,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "What is a simple way to improve retrieval speed and cost?",
      "originalText": "What is a simple way to improve retrieval speed and cost?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8U"
    },
    {
      "id": "sd1884tS4rFcXIZA9Z",
      "type": "text",
      "x": 3502.5,
      "y": 836,
      "width": 1911.6799999999998,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 68353998,
      "version": 41,
      "versionNonce": 1206831007,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Cache query embeddings and retrieval results for the rewritten, normalised query, keyed by index and prompt version so a new index invalidates them. Exact-match hits mostly come from common\nquestions; a semantic cache is the next step. Never cache a full answer that contains a user's own £ figure; only answers with no calculation. Metadata filters shrink the search space; tune HNSW parameters.\nStream tokens to cut perceived latency.",
      "originalText": "Look for: Cache query embeddings and retrieval results for the rewritten, normalised query, keyed by index and prompt version so a new index invalidates them. Exact-match hits mostly come from common\nquestions; a semantic cache is the next step. Never cache a full answer that contains a user's own £ figure; only answers with no calculation. Metadata filters shrink the search space; tune HNSW parameters.\nStream tokens to cut perceived latency.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8V"
    },
