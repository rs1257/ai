      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Where is this system most likely to fail? What is the weakest point?",
      "originalText": "Where is this system most likely to fail? What is the weakest point?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8k"
    },
    {
      "id": "sd1900LjBIJ6pZAvu9",
      "type": "text",
      "x": 3502.5,
      "y": 1396,
      "width": 2004.4799999999998,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 622164686,
      "version": 40,
      "versionNonce": 1165420866,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: The LLM: latency, throttling, hallucination, missed tool calls. Also stale or incorrect corpus and drift between the guidance and the calculator rules. For each, names a mitigation and the metric that would\ndetect it.",
      "originalText": "Look for: The LLM: latency, throttling, hallucination, missed tool calls. Also stale or incorrect corpus and drift between the guidance and the calculator rules. For each, names a mitigation and the metric that would\ndetect it.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8l"
    },
