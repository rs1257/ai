      "link": null,
      "locked": false,
      "text": "Q2",
      "originalText": "Q2",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "sd1865sX5gfKwXaaiY",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8D"
    },
    {
      "id": "sd1867V1V6KZUdOJVo",
      "type": "text",
      "x": 3502.5,
      "y": 265,
      "width": 719.1999999999999,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
