      "index": "b8f"
    },
    {
      "id": "sd1895CDLZuAgOxXRB",
      "type": "text",
      "x": 3502.5,
      "y": 1230,
      "width": 522,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 844878286,
      "version": 40,
      "versionNonce": 1869629873,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "How do you protect user data and credentials?",
      "originalText": "How do you protect user data and credentials?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8g"
    },
    {
      "id": "sd1896iDOagBHlhan9",
      "type": "text",
      "x": 3502.5,
      "y": 1261,
      "width": 1985.9199999999998,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 987523086,
      "version": 41,
      "versionNonce": 1473113752,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Collect only what the calculation needs. Redact PII before the LLM and logs. KMS, Secrets Manager, IAM least privilege per service, VPC endpoints so traffic stays private. Knows WAF can't attach to an API\nGateway WebSocket API: front /chat with CloudFront + WAF, plus throttling and a Lambda authoriser on connect. Defends against prompt injection from users and from retrieved content. Knows Bedrock doesn't train on\ncustomer data. Notes that cross-region inference sends prompts outside the home region, so UK data residency needs an explicit decision.",
      "originalText": "Look for: Collect only what the calculation needs. Redact PII before the LLM and logs. KMS, Secrets Manager, IAM least privilege per service, VPC endpoints so traffic stays private. Knows WAF can't attach to an API\nGateway WebSocket API: front /chat with CloudFront + WAF, plus throttling and a Lambda authoriser on connect. Defends against prompt injection from users and from retrieved content. Knows Bedrock doesn't train on\ncustomer data. Notes that cross-region inference sends prompts outside the home region, so UK data residency needs an explicit decision.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8h"
    },
    {
      "id": "sd18979QKTFtl8mxVK",
      "type": "ellipse",
      "x": 3425.883178660734,
      "y": 1367.0,
      "width": 56,
      "height": 56,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffe3e3",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
