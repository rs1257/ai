      "roundness": null,
      "seed": 1632629720,
      "version": 131,
      "versionNonce": 1686178140,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794408629014,
      "link": null,
      "locked": false,
      "text": "Example sizing assumptions (candidate should state these, then design)\n- ~1M users / year; x10 spikes on Budget and fiscal-event days\n- Peak ~10 chat turns/s; corpus reads >> writes, one history write per turn\n- p95 full answer < 8s; time-to-first-token < 3s (streamed)\n- 99.9% availability; conversation retention 30 days\n- Corpus ~5k pages of guidance; changes weekly at most\n- Scope: SDLT England & NI (Scotland LBTT / Wales LTT out of scope)\n- Production system: real SDLT rules and reliefs, not the Part 1 exercise bands",
      "originalText": "Example sizing assumptions (candidate should state these, then design)\n- ~1M users / year; x10 spikes on Budget and fiscal-event days\n- Peak ~10 chat turns/s; corpus reads >> writes, one history write per turn\n- p95 full answer < 8s; time-to-first-token < 3s (streamed)\n- 99.9% availability; conversation retention 30 days\n- Corpus ~5k pages of guidance; changes weekly at most\n- Scope: SDLT England & NI (Scotland LBTT / Wales LTT out of scope)\n- Production system: real SDLT rules and reliefs, not the Part 1 exercise bands",
      "fontSize": 18,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "middle",
      "containerId": "sd0005kTY7xO5ZIred",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "a5"
    },
