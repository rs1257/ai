    {
      "id": "sd0010fVPuwfT9G8Fl",
      "type": "text",
      "x": 1535,
      "y": -202.77282242320462,
      "width": 1122.974853515625,
      "height": 180,
      "angle": 0,
      "strokeColor": "#1971c2",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
