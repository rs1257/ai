    },
    {
      "id": "sd1887sEme2aY41fqw",
      "type": "text",
      "x": 3502.5,
      "y": 940,
      "width": 916.4,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2142495822,
      "version": 40,
      "versionNonce": 1934458638,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "What if retrieval finds nothing reliable, or Bedrock or the calculator is down?",
      "originalText": "What if retrieval finds nothing reliable, or Bedrock or the calculator is down?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8Y"
    },
    {
      "id": "sd1888IhdOSwlFhVdG",
      "type": "text",
      "x": 3502.5,
      "y": 971,
      "width": 2023.04,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2022582926,
      "version": 40,
      "versionNonce": 727203332,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Below the score threshold: say it is not covered by official guidance and link to GOV.UK, never guess. Retries with backoff and timeouts; circuit breaker on tools. Degrade to calculator-only plus links if the\nLLM is unavailable. Queue redelivery: visibility timeout longer than the slowest turn, an idempotency key per turn so a retry never answers twice, connection ID carried in the message; if the user has disconnected, the\nanswer is saved in DynamoDB and fetched on reconnect. Alert on rising 'not found' and error rates.",
      "originalText": "Look for: Below the score threshold: say it is not covered by official guidance and link to GOV.UK, never guess. Retries with backoff and timeouts; circuit breaker on tools. Degrade to calculator-only plus links if the\nLLM is unavailable. Queue redelivery: visibility timeout longer than the slowest turn, an idempotency key per turn so a retry never answers twice, connection ID carried in the message; if the user has disconnected, the\nanswer is saved in DynamoDB and fetched on reconnect. Alert on rising 'not found' and error rates.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8Z"
    },
    {
      "id": "sd1889Uwv9TYuNE9Ie",
      "type": "ellipse",
      "x": 3425.883178660734,
      "y": 1077.0,
      "width": 56,
      "height": 56,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "#ffe3e3",
      "fillStyle": "solid",
