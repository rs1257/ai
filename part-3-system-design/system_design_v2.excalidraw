    {
      "id": "sdQ16title",
      "type": "text",
      "x": 3502.5,
      "y": 2075,
      "width": 707.6,
      "height": 25.0,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
