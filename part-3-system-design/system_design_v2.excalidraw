    {
      "id": "sd1875i0QqQOHrvCqn",
      "type": "text",
      "x": 3502.5,
      "y": 555,
      "width": 696,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
