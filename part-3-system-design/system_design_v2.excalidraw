    },
    {
      "id": "sd1911jL8yMkGZCVIH",
      "type": "text",
      "x": 3502.5,
      "y": 1730,
      "width": 974.4,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 485706958,
      "version": 40,
      "versionNonce": 1724389349,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "How would you control cost per answer, and stop anonymous users running up the bill?",
      "originalText": "How would you control cost per answer, and stop anonymous users running up the bill?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8w"
    },
    {
      "id": "sd1912wg5pgwKtWv71",
      "type": "text",
      "x": 3502.5,
      "y": 1761,
      "width": 1995.1999999999998,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 2060223246,
      "version": 40,
      "versionNonce": 682784144,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Knows the LLM dominates cost. Per-user and per-guest token budgets; rate limits at the API and per identity; bot checks on guest sessions; caps on output length and agent-loop steps. Tracks cost per answer\nwith budget alarms. Uses the cheapest model that passes the eval set, and caching to avoid repeat calls.",
      "originalText": "Look for: Knows the LLM dominates cost. Per-user and per-guest token budgets; rate limits at the API and per identity; bot checks on guest sessions; caps on output length and agent-loop steps. Tracks cost per answer\nwith budget alarms. Uses the cheapest model that passes the eval set, and caching to avoid repeat calls.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8x"
    },
    {
      "id": "sd1913F4BN49apFn5t",
