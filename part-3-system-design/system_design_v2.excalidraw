    {
      "id": "sd1883O9yIW4EBeCLg",
      "type": "text",
      "x": 3502.5,
      "y": 805,
      "width": 661.1999999999999,
      "height": 25,
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
