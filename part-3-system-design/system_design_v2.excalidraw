      "seed": 923335182,
      "version": 40,
      "versionNonce": 781152480,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "How would you make this platform more sustainable?",
      "originalText": "How would you make this platform more sustainable?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8s"
    },
    {
      "id": "sd1908fFiJGSRL2Hlm",
      "type": "text",
      "x": 3502.5,
      "y": 1626,
      "width": 2013.7599999999998,
      "height": 60,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 943360078,
      "version": 41,
      "versionNonce": 1564735809,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Avoid LLM calls you don't need: /calculate skips the LLM, and retrieval and embedding caches avoid repeat work. Right-size models: a small model for intent routing and query rewrite, the large model only for\nthe final answer. Keep prompts lean (top-k, re-rank, prompt caching). Re-embed only changed docs; batch ingestion offline; Lambda scales to zero, and the always-on parts (Fargate tasks, Redis, OpenSearch capacity) are\nright-sized. Measures energy proxies (tokens per answer) plus provider carbon reporting. Bonus: region choice affects carbon intensity but trades off against UK data residency.",
      "originalText": "Look for: Avoid LLM calls you don't need: /calculate skips the LLM, and retrieval and embedding caches avoid repeat work. Right-size models: a small model for intent routing and query rewrite, the large model only for\nthe final answer. Keep prompts lean (top-k, re-rank, prompt caching). Re-embed only changed docs; batch ingestion offline; Lambda scales to zero, and the always-on parts (Fargate tasks, Redis, OpenSearch capacity) are\nright-sized. Measures energy proxies (tokens per answer) plus provider carbon reporting. Bonus: region choice affects carbon intensity but trades off against UK data residency.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8t"
    },
