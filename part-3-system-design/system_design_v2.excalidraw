      "versionNonce": 454815522,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "How do you know it gives correct answers in production?",
      "originalText": "How do you know it gives correct answers in production?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8o"
    },
    {
      "id": "sd1904VygaMuL5uN4B",
      "type": "text",
      "x": 3502.5,
      "y": 1511,
      "width": 1967.36,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1404994958,
      "version": 40,
      "versionNonce": 143972716,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Offline: golden set and calculator boundary cases run in CI on every prompt, model or index change. Online: groundedness and citation rate, tool-call success, feedback, sampled human review. Per-request\ntraces tagged with prompt, model and index versions so any answer can be reproduced and its source proved.",
      "originalText": "Look for: Offline: golden set and calculator boundary cases run in CI on every prompt, model or index change. Online: groundedness and citation rate, tool-call success, feedback, sampled human review. Per-request\ntraces tagged with prompt, model and index versions so any answer can be reproduced and its source proved.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b8p"
    },
