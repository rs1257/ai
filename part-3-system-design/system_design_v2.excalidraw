      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "What would you ask before you start designing?",
      "originalText": "What would you ask before you start designing?",
      "fontSize": 20,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b86"
    },
    {
      "id": "sd1860vSjsunBW9qqS",
      "type": "text",
      "x": 3502.5,
      "y": 26,
      "width": 1948.8,
      "height": 40,
      "angle": 0,
      "strokeColor": "#2f9e44",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 0,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 416962382,
      "version": 40,
      "versionNonce": 230952003,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1794409137707,
      "link": null,
      "locked": false,
      "text": "Look for: Users / DAU, peak concurrency (spikes on Budget and fiscal-event days), RPS, read:write ratio, latency targets (p50/p95/p99, time-to-first-token), availability target, retention and consistency needs,\njurisdiction scope (SDLT vs LBTT / LTT), cost per query. States assumptions out loud and designs to them.",
      "originalText": "Look for: Users / DAU, peak concurrency (spikes on Budget and fiscal-event days), RPS, read:write ratio, latency targets (p50/p95/p99, time-to-first-token), availability target, retention and consistency needs,\njurisdiction scope (SDLT vs LBTT / LTT), cost per query. States assumptions out loud and designs to them.",
      "fontSize": 16,
      "fontFamily": 5,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b87"
    },
